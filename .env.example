# Copia para .env.local e preenche (Supabase → Project Settings → API Keys).
# Só valores públicos: a segurança está na RLS. Nunca metas aqui a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://<id-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só para `npm run db:types`
SUPABASE_PROJECT_ID=<id-do-projeto>
